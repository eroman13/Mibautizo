# ==================================================
# CONFIGURACIÓN DE ENTORNO — Mesa de Regalos Bautizo
# ==================================================
# Copia este archivo como ".env" y completa los valores.

# -------------------- BASE DE DATOS --------------------
# Ruta al archivo SQLite (relativa al backend)
DATABASE_URL="file:./dev.db"

# -------------------- MERCADO PAGO --------------------
# Obtén tus credenciales en: https://www.mercadopago.cl/developers/panel
# Usa PRIMERO las credenciales de PRUEBA (sandbox) para desarrollar

# Access Token (NUNCA lo compartas ni lo subas a GitHub)
# Producción: empieza con APP_USR-
# Prueba: empieza con TEST-
MP_ACCESS_TOKEN="TEST-tu-access-token-aqui"

# Public Key (va en el frontend, pero por comodidad también aquí)
# Producción: empieza con APP_USR-
# Prueba: empieza con TEST-
MP_PUBLIC_KEY="TEST-tu-public-key-aqui"

# -------------------- COMISIÓN DE MERCADO PAGO --------------------
# Comisión efectiva (incluyendo IVA) que cobra Mercado Pago
# Por defecto: 3.19% + IVA = 3.80% aprox (0.038)
# Ajusta según tu plan de Mercado Pago
MP_COMMISSION_RATE="0.038"

# -------------------- CONFIGURACIÓN DEL SERVIDOR --------------------
# Puerto del backend
PORT="3000"

# URL del frontend (para CORS y redirecciones)
FRONTEND_URL="http://localhost:5173"

# URL del backend (para webhooks y API)
BACKEND_URL="http://localhost:3000"

# -------------------- SEGURIDAD --------------------
# Contraseña simple para acceder al panel admin
# Cambia esto por una contraseña segura
ADMIN_PASSWORD="admin123"

# -------------------- WEBHOOKS --------------------
# Mercado Pago enviará notificaciones aquí
# En desarrollo local, usa ngrok o similar para exponer el puerto
# Ejemplo: https://tu-subdominio.ngrok.io/api/webhook
WEBHOOK_URL="http://localhost:3000/api/webhook"

# -------------------- MODO DE COMISIÓN --------------------
# "A" = El invitado cubre la comisión (tú recibes el 100%)
# "B" = Tú asumes la comisión (el invitado paga el precio exacto)
# Esto también se puede cambiar desde el panel admin
DEFAULT_COMMISSION_MODE="A"

# -------------------- NOTAS --------------------
# 📌 Para obtener credenciales de prueba:
#    1. Crea una cuenta en https://www.mercadopago.cl
#    2. Ve a https://www.mercadopago.cl/developers/panel
#    3. Copia el Access Token y Public Key de PRUEBA
#
# 📌 Tarjetas de prueba de Mercado Pago Chile:
#    - VISA aprobada: 4168 8188 4444 7115
#    - Mastercard aprobada: 5416 7526 0258 2580
#    - CVV: cualquiera de 3 dígitos
#    - Fecha: cualquier fecha futura
#    - Nombre: APRO (para aprobar) o CONT (para contingencia)
#
# 📌 Para producción:
#    - Cambia a credenciales de producción
#    - Configura un dominio real en FRONTEND_URL y BACKEND_URL
#    - Actualiza WEBHOOK_URL con tu URL de producción
