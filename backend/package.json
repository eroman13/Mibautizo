{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend para mesa de regalos - API y webhooks de Mercado Pago",
  "main": "dist/index.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --skipLibCheck && prisma generate",
    "start": "[ -d dist ] || npm run build && node dist/index.js",
    "start:prod": "npm run build && (prisma db push --accept-data-loss || echo 'DB sync skipped') && node dist/index.js",
    "start:shell": "bash start.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mercadopago": "^2.0.15",
    "nodemailer": "^9.1.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
